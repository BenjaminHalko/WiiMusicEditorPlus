{
  "plugin": ["oh-my-opencode@latest"],
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git tag*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git blame*": "allow",
      "git shortlog*": "allow",
      "git describe*": "allow",
      "git check-ignore*": "allow",
      "git checkout*": "allow",
      "git stash*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr status*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh repo view*": "allow",
      "gh release list*": "allow",
      "gh release view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "git push*": "deny",
      "git push --force*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "cargo doc*": "allow",
      "cargo build*": "allow",
      "cargo run*": "allow",
      "cargo bench*": "allow",
      "rustc *": "allow",
      "rustup *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "which *": "allow",
      "sort *": "allow",
      "echo *": "allow",
      "basename *": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "python3 -c*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "secrets/*": "deny"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "skill": "allow",
    "look_at": "allow",
    "background_output": "allow",
    "background_cancel": "allow",
    "ast_grep_search": "allow",
    "ast_grep_replace": "ask",
    "slashcommand": "allow",
    "session_list": "allow",
    "session_read": "allow",
    "session_search": "allow",
    "session_info": "allow",
    "websearch_web_search_exa": "allow",
    "grep_app_searchGitHub": "allow",
    "context7_*": "allow",
    "interactive_bash": "ask"
  }
}
