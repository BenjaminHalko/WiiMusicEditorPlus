import { Button, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";

export component AppSettings inherits Rectangle {
    background: #F2F2F2;

    in-out property <string> rom-path;
    in-out property <string> dolphin-path;
    in-out property <int> language: 0;
    in-out property <int> fallback-region: 0;
    in-out property <bool> discord-rpc: false;
    in-out property <bool> unsafe-mode: false;
    in-out property <bool> normalize-midi: false;

    callback browse-rom();
    callback browse-rom-folder();
    callback browse-dolphin();
    callback language-changed(int);
    callback region-changed(int);
    callback discord-rpc-changed(bool);
    callback unsafe-mode-changed(bool);
    callback normalize-midi-changed(bool);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        HorizontalLayout { height: 36px; spacing: 8px;
            Text { text: @tr("ROM Path"); font-size: 12px; color: #555555; vertical-alignment: center; width: 130px; }
            LineEdit { horizontal-stretch: 1; text: root.rom-path; read-only: true; }
            Button { text: @tr("Browse Disk..."); clicked => { root.browse-rom(); } }
            Button { text: @tr("Browse Folder..."); clicked => { root.browse-rom-folder(); } }
        }

        HorizontalLayout { height: 36px; spacing: 8px;
            Text { text: @tr("Dolphin Path"); font-size: 12px; color: #555555; vertical-alignment: center; width: 130px; }
            LineEdit { horizontal-stretch: 1; text: root.dolphin-path; read-only: true; }
            Button { text: @tr("Browse"); clicked => { root.browse-dolphin(); } }
        }

        HorizontalLayout { height: 36px; spacing: 8px;
            Text { text: @tr("Language"); font-size: 12px; color: #555555; vertical-alignment: center; width: 130px; }
            ComboBox {
                width: 200px;
                model: ["English", "Français", "Español", "Deutsch", "Italiano"];
                current-index: root.language;
                selected(v) => { root.language-changed(self.current-index); }
            }
        }

        HorizontalLayout { height: 36px; spacing: 8px;
            Text { text: @tr("Fallback Region"); font-size: 12px; color: #555555; vertical-alignment: center; width: 130px; }
            ComboBox {
                width: 200px;
                model: [@tr("U.S."), @tr("Europe"), @tr("Japan"), @tr("Korea")];
                current-index: root.fallback-region;
                selected(v) => { root.region-changed(self.current-index); }
            }
        }

        VerticalLayout {
            spacing: 10px;
            CheckBox { text: @tr("Discord RPC");    checked <=> root.discord-rpc;    toggled => { root.discord-rpc-changed(self.checked); } }
            CheckBox { text: @tr("Unsafe Mode");    checked <=> root.unsafe-mode;    toggled => { root.unsafe-mode-changed(self.checked); } }
            CheckBox { text: @tr("Normalize MIDI"); checked <=> root.normalize-midi; toggled => { root.normalize-midi-changed(self.checked); } }
        }
    }
}
